{
  "name": "festora-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/currency.test.ts tests/budget.test.ts tests/timeline.test.ts tests/seating.test.ts tests/security.test.ts tests/validation.test.ts tests/ai-provider.test.ts tests/integration-flow.test.ts tests/edge-cases.test.ts tests/api-route.test.ts tests/component-render.test.tsx tests/axe.test.ts tests/focus-trap.test.tsx tests/efficiency.test.ts",
    "test:coverage": "node scripts/test-with-coverage.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,md,yml,yaml}\"",
    "check-contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15"
  }
}
