# ========================================================
# Festora AI — Environment Variables Reference
# ========================================================

# [Optional] Google Gemini API Key for Generative AI Features
# When omitted, Festora AI automatically activates the built-in deterministic mathematical engine.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# [Required in Production] Public Base URL of the Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [Production Server Config]
PORT=3000
HOSTNAME="0.0.0.0"
NODE_ENV="production"
