# ========================================================
# Festora AI — Environment Variables Reference
# ========================================================

# [Optional] Google Gemini API Key for Generative AI Features
# When omitted, Festora AI automatically activates the built-in deterministic mathematical engine.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Supported Gemini API model. Google currently lists gemini-3.8-flash as a current Flash endpoint.
GEMINI_MODEL="gemini-3.8-flash"

# [Required in Production] Public Base URL of the Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [Production Server Config]
PORT=3000
HOSTNAME="0.0.0.0"
NODE_ENV="production"

# Optional shared rate-limit store for serverless/multi-container deployments.
# Leave both blank for the process-local development fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
